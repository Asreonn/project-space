[layer_names]

3d_render/layer_1="world"
3d_render/layer_2="minimap"
3d_physics/layer_1="player"
3d_physics/layer_2="enemy"
3d_physics/layer_3="asteroid"
3d_physics/layer_4="pickup"
3d_physics/layer_5="player_projectile"
3d_physics/layer_6="enemy_projectile"
3d_physics/layer_7="world"

[physics]

3d/default_gravity=0.0

[rendering]

renderer/rendering_method="forward_plus"

anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.04, 0.035, 0.09, 1)
anti_aliasing/quality/screen_space_aa=1
