# Normalize text, keep Godot files LF
* text=auto eol=lf
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.gdshader text eol=lf
*.godot text eol=lf
*.import text eol=lf
*.md text eol=lf

# Git LFS — heavy binary SOURCE/ASSET files (see AGENTS.md "Git LFS")
*.blend filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.kra filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.ptex filter=lfs diff=lfs merge=lfs -text
*.efkefc filter=lfs diff=lfs merge=lfs -text

# Small binaries stay in plain git (reference PNG/PDF ~33 MB total, game textures, ogg)
*.png binary
*.jpg binary
*.webp binary
*.pdf binary
*.ogg binary
*.ttf binary
*.otf binary
